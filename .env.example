# Backend base URL (server-side only; the browser calls /api on this app)
API_URL=http://localhost:3001

# Public backend URL shown as the Zanroo webhook URL in Projects & access (e.g. https://api.example.com).
# Empty = the dashboard's own domain, which forwards /api to the backend.
NEXT_PUBLIC_API_PUBLIC_URL=

# direct = multipart upload to the API (local / VPS). blob = Vercel Blob client upload (Vercel).
NEXT_PUBLIC_UPLOAD_MODE=direct

# Vercel Blob store token, only for NEXT_PUBLIC_UPLOAD_MODE=blob
BLOB_READ_WRITE_TOKEN=
